{
  "name": "nexo-prototipo",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo clicable de Nexo, app de servicios del campus de la Universidad Metropolitana",
  "scripts": {
    "dev": "npx --yes serve -l 3000 .",
    "test": "python3 tests/smoke.py",
    "build": "python3 scripts/build_single.py",
    "build:app": "python3 scripts/build_pwa.py",
    "deploy": "python3 scripts/deploy_netlify.py",
    "deploy:borrador": "python3 scripts/deploy_netlify.py --borrador"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^9.42.1"
  }
}
